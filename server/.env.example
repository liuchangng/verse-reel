# Agnes AI 配置
AGNES_API_KEY=sk-your-api-key-here
AGNES_BASE_URL=https://api.agnes-ai.cn/v1

# 模型配置
TEXT_MODEL=agnes-2.5-flash
IMAGE_MODEL=agnes-image-2.1-flash
VIDEO_MODEL=agnes-video-2.5-flash

# 并发配置
TEXT_CONCURRENCY=5
IMAGE_CONCURRENCY=5
VIDEO_CONCURRENCY=1
CRITIC_CONCURRENCY=5

# 质检阈值
SCRIPT_SCORE_THRESHOLD=7.0
IMAGE_SCORE_THRESHOLD=7.0
MAX_RETRIES=3

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./data/poems.db

# 文件路径
XML_FILE_PATH=G:/cnkgraph/CNKGraph.Writings.xml
OUTPUT_DIR=./data/output

# 服务器配置
HOST=0.0.0.0
PORT=8000
DEBUG=true
