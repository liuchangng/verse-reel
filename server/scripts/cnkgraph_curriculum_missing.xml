<!-- 课标篇目库内缺失补录（小学75首中确无的2首） -->
<Writings>
  <Poem Id="9000001" D="唐" AU="张志和" T="詞">
    <Title C="漁歌子"/>
    <Ju C="西塞山前白鷺飛"/>
    <Ju C="桃花流水鳜魚肥"/>
    <Ju C="青箬笠綠蓑衣"/>
    <Ju C="斜風細雨不須歸"/>
  </Poem>

  <Poem Id="9000002" D="唐" AU="杜牧" T="詩">
    <Title C="清明"/>
    <Ju C="清明時節雨紛紛"/>
    <Ju C="路上行人欲斷魂"/>
    <Ju C="借問酒家何處有"/>
    <Ju C="牧童遙指杏花村"/>
  </Poem>
</Writings>
