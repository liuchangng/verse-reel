<?xml version="1.0" encoding="UTF-8"?>
<!--
  CNKGraph 诗词导入格式模板
  ====================================================
  用途：server/scripts/import_xml_fast.py 读取此格式并导入 poems.db
  用法：python scripts/import_xml_fast.py --file <本文件>.xml

  字段说明：
    <Poem> 属性：
      Id  : 唯一整数 ID，导入去重依据（必填，重复则跳过）
      D   : 朝代，如 唐 / 宋 / 元 / 明 / 清 / 先秦
      AU  : 作者名
      T   : 体裁，如 诗 / 词 / 文 / 赋 / 曲 / 论
      R   : 韵部（可选）
    子元素：
      <Title C="..."/> : 标题（支持繁体，脚本自动转简体）
      多个 <Ju C="..."/> : 每句正文（支持繁体，自动转简体，按顺序拼接）

  注意：
    - 外层 <Writings> 为可选根节点，脚本按 <Poem> 标签流式解析
    - 标题/作者/正文填繁体或简体均可，脚本统一转简体存储
    - Id 必须唯一且为整数，与已入库 Id 重复的诗会自动跳过
  ====================================================
-->
<Writings>
  <Poem Id="1000001" D="唐" AU="李白" T="詩" R="陽">
    <Title C="靜夜思"/>
    <Ju C="床前明月光"/>
    <Ju C="疑是地上霜"/>
    <Ju C="舉頭望明月"/>
    <Ju C="低頭思故鄉"/>
  </Poem>

  <Poem Id="1000002" D="宋" AU="蘇軾" T="詞" R="虞">
    <Title C="水調歌頭"/>
    <Ju C="明月幾時有"/>
    <Ju C="把酒問青天"/>
    <Ju C="不知天上宮闕"/>
    <Ju C="今夕是何年"/>
  </Poem>

  <Poem Id="1000003" D="唐" AU="杜甫" T="詩" R="塵">
    <Title C="春望"/>
    <Ju C="國破山河在"/>
    <Ju C="城春草木深"/>
    <Ju C="感時花濺淚"/>
    <Ju C="恨別鳥驚心"/>
  </Poem>
</Writings>
