# ===== 古诗词短视频工厂 — 环境变量模板 =====
# 复制为 .env（server/ 下）并填入真实值。密钥严禁写进代码/提交 git。
# 安全加固（2026-09-07）：以下密钥已从代码移除，必须在此配置，否则对应功能不可用。

# ---- 鉴权（REQ-S2 必填）----
# 访问 /api/* 与 /ws/* 需携带 Authorization: Bearer <APP_TOKEN>（前端 VITE_APP_TOKEN 保持一致）
APP_TOKEN=

# ---- Agnes AI 三模型密钥（REQ-S1：从代码移除后必须在此配置）----
text_api_key=
image_api_key=
video_api_key=

# ---- 外部服务（历史兼容 / 可选项）----
# AGNES_API_KEY=            # 旧字段名兼容占位（新代码使用 text_api_key 等）

# ---- 部署 ----
# DEBUG=false               # 生产环境关闭调试（默认即关闭，显式开启用 DEBUG=true）
